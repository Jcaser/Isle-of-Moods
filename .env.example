# ===== 岛主 AI 接入（火山方舟 Ark / OpenAI 兼容协议）=====
#
# 复制本文件为 .env.local，填入自己的密钥。.env.local 已被 .gitignore 忽略，
# 密钥不会被提交到 Git，也不会被打包进前端产物（没有 VITE_ 前缀 = 只在服务端可见）。
#
# ⚠️ 必须使用火山方舟官方开放 API，禁止爬取网页版接口。

# 火山方舟 API Key（控制台 → API Key 管理）
ARK_API_KEY=

# 模型 ID（控制台 → 开通管理 里已开通的模型；本项目使用 doubao-seed-* 系列）
# 可用 GET /api/v3/models 查看账号可见模型，未开通的会返回 ModelNotOpen
ARK_MODEL=doubao-seed-2-1-turbo-260628

# 接口地址，一般不用改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 自设 token 安全上限：累计用量触达后代理立即拒绝请求并提示「额度已用完」
# 这是本地保险丝，不是平台真实额度。按自己免费额度的七成左右设置更稳妥。
ARK_TOKEN_BUDGET=300000

# 单次回复的最大输出 tokens（控制回复长度与花费）
ARK_MAX_OUTPUT_TOKENS=700

# 每分钟最多请求数，防误触烧额度
ARK_RATE_LIMIT=20

# 本地代理端口
PROXY_PORT=8787

# ===== 可选：外部 MCP Server（Model Context Protocol）=====
# 逗号分隔，支持 Streamable HTTP 传输的 MCP Server 地址，例如：
#   MCP_SERVERS=http://127.0.0.1:8791/mcp
# 留空则只用内置的 7 个 Function Calling 工具，功能不受影响。
MCP_SERVERS=

# ===== 前端可选（非必需）=====
# 留空即使用默认的本地代理模式。若确实需要前端直连某服务，再填 VITE_LLM_BASE_URL。
# 注意：VITE_ 前缀的变量会被打包进前端产物，切勿在此写真实 Key。
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=
VITE_LLM_API_KEY=
